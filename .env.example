# Example only: copy to .env (ignored by Git) and edit local paths.
# No tokens, API keys, or passwords belong in this file.
# Load before running commands via:
#   set -a && source .env && set +a
# or pass OMNIOPD_LOAD_ENV=1 when invoking repository launchers.
#
# These defaults match Qwen2.5-Omni-7B / reviewed REF-AVS SAM2 settings;
# inspect each selected checkpoint's saved args.json and manifest first.

# Python / ms-swift environment (optional if .venv is activated or at ./.venv)
SWIFT_ENV=/path/to/isolated-python-environment
PYTHON_BIN=/path/to/isolated-python-environment/bin/python
SWIFT_BIN=/path/to/isolated-python-environment/bin/swift

# Model and SAM2 weights
MODEL=/path/to/Qwen2___5-Omni-7B
SAM2_CHECKPOINT=/path/to/sam2_hiera_large.pt
AURORA_SAM2_CHECKPOINT=/path/to/sam2_hiera_large.pt

# SFT / GRPO / OPD checkpoints and data roots
INIT_ADAPTER=/path/to/stage1_initializer_adapter
DATA_DIR=/path/to/reviewed_merged_sft_dir
SFT_CHECKPOINT=/path/to/merged_sft/checkpoint-4809
DATA_ROOT=/path/to/student_only_online_opd_dir

# Local timing audit (generated via scripts/eval/omni_eval_settings.py)
DATASET_AUDIT=/path/to/outputs/artifacts/audit.json
# Relocated training JSONL used by test_qwen2_5_omni_refavs.py prompt-style parity checks
TRAIN_PROMPT_SOURCE=/path/to/relocated_structured_cot.jsonl

# Media timeline and segmentation backend
FPS=1.0
AURORA_VIDEO_FPS=1.0
AURORA_SEG_BACKEND=sam2

# Legacy 3B Stage-1 SAM ViT-H scripts use MODEL_PATH and AURORA_SAM_CHECKPOINT:
# MODEL_PATH=/path/to/Qwen2___5-Omni-3B
# AURORA_SAM_CHECKPOINT=/path/to/sam_vit_h_4b8939.pth
